<Window x:Class="MyGymManager.App.Views.MemberEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyGymManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Chỉnh Sửa Hội Viên &amp; Gia Hạn Gói Tập — Phuc Gym"
        Height="630" Width="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#F8F9FA"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="BrushPrimaryOrange" Color="#FF6B00" />
        <SolidColorBrush x:Key="BrushPrimaryOrangeHover" Color="#E65F00" />
        <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#9CA3AF" />

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimaryOrange}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrimaryOrangeHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D1D5DB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto" />
            <!-- 2. Form Content -->
            <RowDefinition Height="*" />
            <!-- 3. Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="CHỈNH SỬA HỘI VIÊN &amp; GIA HẠN" FontSize="18" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock Text="Cập nhật hồ sơ, bật/khóa thẻ hoặc gia hạn thời gian tập" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Thông tin cơ bản -->
                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Hồ Sơ Hội Viên" FontSize="14" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />

                        <!-- Họ và Tên -->
                        <TextBlock Text="Họ và Tên (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,12">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Số điện thoại -->
                        <TextBlock Text="Số điện thoại (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,12">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Trạng thái hoạt động (IsActive) -->
                        <CheckBox IsChecked="{Binding IsActive}" VerticalContentAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Thẻ hội viên đang hoạt động (Cho phép quẹt mặt điểm danh)" FontSize="13" FontWeight="500" Foreground="{StaticResource BrushTextPrimary}" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Tình trạng gói tập hiện tại & Gia hạn -->
                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tình Trạng Gói Tập &amp; Gia Hạn" FontSize="14" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />

                        <!-- Tóm tắt gói hiện tại -->
                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Gói tập hiện hành:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding CurrentPackageName}" FontSize="13" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Trạng thái hạn thẻ:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding ExpiryStatusText}" FontSize="12" FontWeight="600" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Checkbox chọn Gia hạn -->
                        <CheckBox IsChecked="{Binding DoRenew}" VerticalContentAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Gia hạn thêm thời gian tập cho hội viên này" FontSize="13" FontWeight="600" Foreground="{StaticResource BrushPrimaryOrange}" />
                        </CheckBox>

                        <!-- Panel chọn số ngày gia hạn (Chỉ hiện khi DoRenew = True) -->
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="14"
                                Visibility="{Binding DoRenew, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Số ngày muốn gia hạn cộng thêm (*):" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ô nhập số ngày -->
                                    <TextBox Grid.Column="0" Text="{Binding RenewDays, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <!-- Nút chọn nhanh (30, 90, 365) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding QuickRenewOptions}" SelectedItem="{Binding RenewDays}" Height="36" Width="90" FontSize="12" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="💡 Nếu thẻ còn hạn sẽ được cộng dồn tiếp; nếu đã hết hạn sẽ tính từ thời điểm hiện tại." FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="600" Foreground="#EF4444" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryBtn}" Content="Hủy bỏ" Command="{Binding CancelCommand}" Width="90" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryBtn}" Content="💾 Lưu Thay Đổi" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
