<Window x:Class="MyGymManager.App.Views.CustomerFacingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyGymManager.App.Views"
        xmlns:vm="clr-namespace:MyGymManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Phuc Gym — Customer Facing Display (Kiosk Mode)"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Inter, Arial, sans-serif"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="680">

    <Window.Resources>
        <!-- ================= PALETTE COLORS (NỀN TỐI #0F172A, CAM #FF6B00) ================= -->
        <Color x:Key="ColorBgDark">#0F172A</Color>
        <Color x:Key="ColorCardDark">#1E293B</Color>
        <Color x:Key="ColorCardInner">#0F172A</Color>
        <Color x:Key="ColorBorder">#334155</Color>
        <Color x:Key="ColorPrimaryOrange">#FF6B00</Color>
        <Color x:Key="ColorPrimaryOrangeGlow">#FF8533</Color>
        <Color x:Key="ColorSuccessGreen">#10B981</Color>
        <Color x:Key="ColorAlertRed">#EF4444</Color>
        <Color x:Key="ColorTextMuted">#94A3B8</Color>

        <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
        <SolidColorBrush x:Key="BrushCardDark" Color="{StaticResource ColorCardDark}" />
        <SolidColorBrush x:Key="BrushCardInner" Color="{StaticResource ColorCardInner}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="BrushPrimaryOrange" Color="{StaticResource ColorPrimaryOrange}" />
        <SolidColorBrush x:Key="BrushPrimaryOrangeGlow" Color="{StaticResource ColorPrimaryOrangeGlow}" />
        <SolidColorBrush x:Key="BrushSuccessGreen" Color="{StaticResource ColorSuccessGreen}" />
        <SolidColorBrush x:Key="BrushAlertRed" Color="{StaticResource ColorAlertRed}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Hiệu ứng đổ bóng Neon Cam -->
        <DropShadowEffect x:Key="OrangeGlowEffect" BlurRadius="24" Color="#FF6B00" Opacity="0.35" ShadowDepth="0" />
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="16" Color="#000000" Opacity="0.4" ShadowDepth="4" Direction="270" />
        <DropShadowEffect x:Key="GreenGlowEffect" BlurRadius="24" Color="#10B981" Opacity="0.35" ShadowDepth="0" />

        <!-- Card Container Style -->
        <Style x:Key="DarkKioskCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCardDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect" Value="{StaticResource SoftCardShadow}" />
        </Style>

        <!-- Nút bấm Kiosk phụ -->
        <Style x:Key="KioskIconButton" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BrushPrimaryOrange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================= MAIN ROOT GRID ================= -->
    <Grid Background="{StaticResource BrushBgDark}">
        <Grid.RowDefinitions>
            <!-- 1. Header Bar Kiosk Mode -->
            <RowDefinition Height="74" />
            <!-- 2. Main Content Viewport -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Marquee Status Footer -->
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: KIOSK HEADER BAR                                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#131D33" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Brand & Logo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Status Pill & Screen Mode -->
                    <ColumnDefinition Width="*" />
                    <!-- Live Real-Time Clock & Admin Actions -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Brand Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo Shield Icon -->
                    <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0" Effect="{StaticResource OrangeGlowEffect}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B00" Offset="0" />
                                <GradientStop Color="#FF9033" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Fill="#FFFFFF" Stretch="Uniform" Width="22" Height="22"
                              Data="M12,2 L20,5 L20,9 A8,8 0 0,1 12,17 A8,8 0 0,1 4,9 L4,5 Z M12,19 L7,22 L8,18 Z M12,19 L17,22 L16,18 Z" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PHÚC GYM" FontSize="22" FontWeight="900" Foreground="#FFFFFF" />
                            <Border Background="#FF6B00" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="KIOSK DISPLAY" FontSize="10" FontWeight="800" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Cổng Điểm Danh &amp; Kiểm Soát Hội Viên Thông Minh" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Central Status Indicator Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Ready Status Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#10B981" Opacity="0.8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="700" Foreground="{Binding StatusBadgeFg}" />
                        </StackPanel>
                    </Border>

                    <!-- Secondary Screen HDMI Info Pill -->
                    <Border Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️ " FontSize="12" />
                            <TextBlock Text="{Binding DisplayScreenInfo}" FontSize="11" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Realtime Clock & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live Digital Clock -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,6" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"
                                  Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,6 V12 L16,14" StrokeThickness="1" />
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentTimeText}" FontSize="16" FontWeight="800" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding CurrentDateText}" FontSize="10" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nút chuyển đổi màn hình kế tiếp -->
                    <Button Style="{StaticResource KioskIconButton}" Click="OnSwitchScreenClick" Margin="0,0,8,0" ToolTip="Chuyển sang màn hình khác (F12)">
                        <TextBlock Text="🔄 Màn hình" FontSize="11" FontWeight="600" />
                    </Button>

                    <!-- Nút thu nhỏ / thoát Kiosk -->
                    <Button Style="{StaticResource KioskIconButton}" Click="OnCloseKioskClick" ToolTip="Đóng Kiosk (Esc)">
                        <TextBlock Text="✕" FontSize="12" FontWeight="700" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: MAIN BODY (KHUNG CAMERA LỚN + CARD CHÀO MỪNG TO)                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="24,20,24,14">
            <Grid.ColumnDefinitions>
                <!-- CỘT TRÁI: Khung Camera Lớn & Thanh Icon Phương thức xác thực (56%) -->
                <ColumnDefinition Width="1.25*" />
                <!-- CỘT PHẢI: Card Chào Mừng To & Thông Tin Hội Viên (44%) -->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- CỘT TRÁI: KHUNG CAMERA LỚN & ĐA PHƯƠNG THỨC XÁC THỰC                 -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <!-- Khung Camera Lớn -->
                    <RowDefinition Height="*" />
                    <!-- Thanh Phương Thức Xác Thực (Pluggable Multi-Biometrics) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. KHUNG CAMERA LỚN CHUẨN KIOSK -->
                <Border Grid.Row="0" Style="{StaticResource DarkKioskCard}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Camera Header Title -->
                            <RowDefinition Height="Auto" />
                            <!-- Viewport Container -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header trên khung camera -->
                        <Grid Grid.Row="0" Margin="4,0,4,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource BrushPrimaryOrange}" Margin="0,0,10,0" Effect="{StaticResource OrangeGlowEffect}" />
                                <TextBlock Text="CAMERA QUÉT SINH TRẮC HỌC THỜI GIAN THỰC" FontSize="14" FontWeight="800" Foreground="#FFFFFF" />
                            </StackPanel>

                            <!-- Live badge -->
                            <Border HorizontalAlignment="Right" Background="#0A0F1D" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" />
                                    <TextBlock Text="AI VISION • 60 FPS" FontSize="11" FontWeight="700" Foreground="#10B981" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Khung hình Camera Feed thực tế -->
                        <Border Grid.Row="1" CornerRadius="16" Background="#070C18" BorderBrush="#FF6B00" BorderThickness="2" ClipToBounds="True">
                            <Grid>
                                <!-- 1. Standby Background khi chưa có feed -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#334155" Stretch="Uniform" Width="64" Height="64" Margin="0,0,0,16"
                                          Data="M4,4 H7 L9,2 H15 L17,4 H20 A2,2 0 0,1 22,6 V18 A2,2 0 0,1 20,20 H4 A2,2 0 0,1 2,18 V6 A2,2 0 0,1 4,4 Z M12,7 A5,5 0 1,0 12,17 A5,5 0 0,0 12,7 Z" />
                                    <TextBlock Text="ĐANG KẾT NỐI CAMERA SINH TRẮC HỌC..." FontSize="14" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Vui lòng đứng trước thiết bị quét" FontSize="12" Foreground="#475569" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- 2. Live Video Feed từ Camera (OpenCvSharp Frame qua WriteableBitmap) -->
                                <Image Source="{Binding CameraFeed}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- 3. HUD OVERLAY: 4 GÓC NGẮM AI BIOMETRICS BẰNG MÀU CAM #FF6B00 -->
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                    <!-- Góc trên - Trái -->
                                    <Path Canvas.Left="30" Canvas.Top="30" Stroke="#FF6B00" StrokeThickness="4"
                                          Data="M0,40 L0,0 L40,0" Effect="{StaticResource OrangeGlowEffect}" />

                                    <!-- Góc trên - Phải -->
                                    <Path Canvas.Right="30" Canvas.Top="30" Stroke="#FF6B00" StrokeThickness="4"
                                          Data="M40,40 L40,0 L0,0" Effect="{StaticResource OrangeGlowEffect}" />

                                    <!-- Góc dưới - Trái -->
                                    <Path Canvas.Left="30" Canvas.Bottom="30" Stroke="#FF6B00" StrokeThickness="4"
                                          Data="M0,0 L0,40 L40,40" Effect="{StaticResource OrangeGlowEffect}" />

                                    <!-- Góc dưới - Phải -->
                                    <Path Canvas.Right="30" Canvas.Bottom="30" Stroke="#FF6B00" StrokeThickness="4"
                                          Data="M40,0 L40,40 L0,40" Effect="{StaticResource OrangeGlowEffect}" />
                                </Canvas>

                                <!-- 4. Khung Oval Hướng Dẫn Tâm Nhìn Mặt (Center Reticle Guide) -->
                                <Border Width="260" Height="340" CornerRadius="130" BorderBrush="#40FF6B00" BorderThickness="2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFaceInFrame}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- 5. Floating Badge dưới chân camera hướng dẫn người dùng -->
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                                        Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="24" Padding="20,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👁️ " FontSize="14" />
                                        <TextBlock Text="Vui lòng nhìn thẳng vào camera để hệ thống nhận diện tự động" FontSize="13" FontWeight="600" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. THANH PHƯƠNG THỨC XÁC THỰC (PLUGGABLE MULTI-BIOMETRICS) -->
                <Border Grid.Row="1" Style="{StaticResource DarkKioskCard}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="PHƯƠNG THỨC XÁC THỰC ĐƯỢC HỆ THỐNG HỖ TRỢ (PLUGGABLE MULTI-BIOMETRICS)"
                                   FontSize="11" FontWeight="800" Foreground="{StaticResource BrushTextMuted}" Margin="4,0,0,10" />

                        <!-- 5 Icon đại diện cho 5 phương thức trong IdentificationMethod -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 0. FaceRecognition -->
                                <ColumnDefinition Width="*" />
                                <!-- 1. Fingerprint -->
                                <ColumnDefinition Width="*" />
                                <!-- 2. RfidCard -->
                                <ColumnDefinition Width="*" />
                                <!-- 3. QrCode -->
                                <ColumnDefinition Width="*" />
                                <!-- 4. Manual -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Method 0: Face Recognition -->
                            <Border Grid.Column="0" CornerRadius="12" Padding="8,10" Margin="2,0" Background="#131D33" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E293B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFaceMethodActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                <Setter Property="Background" Value="#2A1B14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,6"
                                          Data="M3,4 A1,1 0 0,1 4,3 L8,3 A1,1 0 0,1 8,5 L5,5 L5,8 A1,1 0 0,1 3,8 Z M16,3 A1,1 0 0,1 20,3 L20,4 L20,8 A1,1 0 0,1 18,8 L18,5 L16,5 A1,1 0 0,1 16,3 Z M3,16 A1,1 0 0,1 5,16 L5,19 L8,19 A1,1 0 0,1 8,21 L4,21 A1,1 0 0,1 3,20 Z M19,16 A1,1 0 0,1 21,16 L21,20 A1,1 0 0,1 20,21 L16,21 A1,1 0 0,1 16,19 L19,19 L19,16 Z M12,7 A3,3 0 1,0 12,13 A3,3 0 0,0 12,7 Z" />
                                    <TextBlock Text="Khuôn Mặt" FontSize="11" FontWeight="700" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="InsightFace 3D" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Method 1: Fingerprint -->
                            <Border Grid.Column="1" CornerRadius="12" Padding="8,10" Margin="2,0" Background="#131D33" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E293B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFingerprintMethodActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                <Setter Property="Background" Value="#2A1B14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,6"
                                          Data="M12,2 A9,9 0 0,0 3,11 C3,13 3.5,15 4.3,16.8 L5.8,15.7 C5.3,14.3 5,12.7 5,11 A7,7 0 0,1 19,11 C19,12 18.7,13.2 18.2,14.2 L19.8,15 C20.6,13.7 21,12.4 21,11 A9,9 0 0,0 12,2 Z M12,6 A5,5 0 0,0 7,11 C7,12.5 7.4,13.9 8.1,15.1 L9.6,14.2 C9.2,13.3 9,12.2 9,11 A3,3 0 0,1 15,11 C15,11.8 14.8,12.5 14.5,13.2 L16.1,14 C16.7,13.1 17,12.1 17,11 A5,5 0 0,0 12,6 Z M12,10 A1,1 0 0,0 11,11 C11,13.5 9.5,15.5 9.5,17.5 C9.5,19 10.5,20.5 12,20.8 C13.5,20.5 14.5,19 14.5,17.5 C14.5,16 13.5,14.5 13,13.5 L12,11.5 Z" />
                                    <TextBlock Text="Vân Tay" FontSize="11" FontWeight="700" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Biometric ZK" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Method 2: RFID Card -->
                            <Border Grid.Column="2" CornerRadius="12" Padding="8,10" Margin="2,0" Background="#131D33" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E293B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRfidMethodActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                <Setter Property="Background" Value="#2A1B14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,6"
                                          Data="M3,5 A2,2 0 0,1 5,3 L19,3 A2,2 0 0,1 21,5 L21,19 A2,2 0 0,1 19,21 L5,21 A2,2 0 0,1 3,19 Z M5,5 L19,5 L19,8 L5,8 Z M5,10 L5,19 L19,19 L19,10 Z M7,13 A4,4 0 0,1 11,17 L9.5,17 A2.5,2.5 0 0,0 7,14.5 Z" />
                                    <TextBlock Text="Thẻ Từ RFID" FontSize="11" FontWeight="700" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Mifare 13.56MHz" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Method 3: QR Code -->
                            <Border Grid.Column="3" CornerRadius="12" Padding="8,10" Margin="2,0" Background="#131D33" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E293B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQrMethodActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                <Setter Property="Background" Value="#2A1B14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,6"
                                          Data="M3,3 L9,3 L9,9 L3,9 Z M5,5 L7,5 L7,7 L5,7 Z M15,3 L21,3 L21,9 L15,9 Z M17,5 L19,5 L19,7 L17,7 Z M3,15 L9,15 L9,21 L3,21 Z M5,17 L7,17 L7,19 L5,19 Z M13,3 L13,7 L11,7 L11,3 Z M15,15 L17,15 L17,17 L15,17 Z M19,15 L21,15 L21,21 L19,21 Z" />
                                    <TextBlock Text="Mã QR App" FontSize="11" FontWeight="700" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Quét điện thoại" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Method 4: Manual SĐT -->
                            <Border Grid.Column="4" CornerRadius="12" Padding="8,10" Margin="2,0" Background="#131D33" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#1E293B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManualMethodActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                <Setter Property="Background" Value="#2A1B14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Fill="{StaticResource BrushPrimaryOrange}" Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,6"
                                          Data="M6.5,2 L17.5,2 A2.5,2.5 0 0,1 20,4.5 L20,19.5 A2.5,2.5 0 0,1 17.5,22 L6.5,22 A2.5,2.5 0 0,1 4,19.5 L4,4.5 A2.5,2.5 0 0,1 6.5,2 Z M6,5 L6,17 L18,17 L18,5 Z M12,18.5 A1,1 0 1,0 12,20.5 A1,1 0 0,0 12,18.5 Z" />
                                    <TextBlock Text="Số Điện Thoại" FontSize="11" FontWeight="700" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Lễ tân hỗ trợ" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- CỘT PHẢI: CARD CHÀO MỪNG TO (STANDBY vs IDENTIFIED STATES)            -->
            <!-- ===================================================================== -->
            <Border Grid.Column="1" Style="{StaticResource DarkKioskCard}" Padding="32,28">
                <Grid>
                    <!-- ============================================================= -->
                    <!-- TRẠNG THÁI 1: CHỜ HỘI VIÊN (IDLE / STANDBY STATE)              -->
                    <!-- ============================================================= -->
                    <Grid Visibility="{Binding IsIdleState, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <!-- Big Hero Banner -->
                            <RowDefinition Height="Auto" />
                            <!-- 3 Step Guidance Cards -->
                            <RowDefinition Height="*" />
                            <!-- Bottom Motivational Box -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Big Hero Welcome -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,16,0,28">
                            <!-- Glowing Trophy / Shield Badge -->
                            <Border Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" Margin="0,0,0,20" Effect="{StaticResource OrangeGlowEffect}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6B00" Offset="0" />
                                        <GradientStop Color="#FF8E3D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#FFFFFF" Stretch="Uniform" Width="46" Height="46"
                                      Data="M5,2 L19,2 L19,5 L17,5 L17,8 C17,10.8 14.8,13 12,13 C9.2,13 7,10.8 7,8 L7,5 L5,5 Z M3,5 H5 V8 C5,9.5 5.8,10.8 7.1,11.5 C6.4,12.5 6,13.7 6,15 V17 H18 V15 C18,13.7 17.6,12.5 16.9,11.5 C18.2,10.8 19,9.5 19,8 V5 H21 V8 C21,11 18.7,13.4 15.8,13.9 C15.4,15.1 14.6,16.2 13.5,16.9 L14,20 H16 V22 H8 V20 H10 L10.5,16.9 C9.4,16.2 8.6,15.1 8.2,13.9 C5.3,13.4 3,11 3,8 Z" />
                            </Border>

                            <TextBlock Text="XIN CHÀO QUÝ HỘI VIÊN" FontSize="30" FontWeight="900" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="HỆ THỐNG ĐIỂM DANH TỰ ĐỘNG PHÚC GYM" FontSize="14" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="Vui lòng đứng trước camera hoặc quẹt thẻ / quét mã QR để vào phòng tập" FontSize="13" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" />
                        </StackPanel>

                        <!-- 3 Step Guidance Cards -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20">
                            <!-- Bước 1 -->
                            <Border Background="#131D33" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#FF6B00" HorizontalAlignment="Left">
                                        <TextBlock Text="1" FontSize="14" FontWeight="900" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nhìn thẳng vào Camera Quét" FontSize="14" FontWeight="800" Foreground="#FFFFFF" />
                                        <TextBlock Text="Giữ khuôn mặt tự nhiên trong khung hình từ 1 - 2 giây" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bước 2 -->
                            <Border Background="#131D33" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#2563EB" HorizontalAlignment="Left">
                                        <TextBlock Text="2" FontSize="14" FontWeight="900" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Hoặc Quẹt Thẻ Từ / Quét Mã QR" FontSize="14" FontWeight="800" Foreground="#FFFFFF" />
                                        <TextBlock Text="Chạm thẻ vào đầu đọc RFID hoặc mở mã QR trên app di động" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bước 3 -->
                            <Border Background="#131D33" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#10B981" HorizontalAlignment="Left">
                                        <TextBlock Text="3" FontSize="14" FontWeight="900" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Cửa Mở Tự Động — Vào Tập Ngay" FontSize="14" FontWeight="800" Foreground="#FFFFFF" />
                                        <TextBlock Text="Hệ thống xác thực nhanh &lt; 0.2s và ghi nhận lượt tập hôm nay" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Motivational Motto -->
                        <Border Grid.Row="2" Background="#0A0F1D" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="18,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔥 NO PAIN, NO GAIN • HÃY LUYỆN TẬP HẾT MÌNH HÔM NAY!" FontSize="12" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Center" />
                                <TextBlock Text="Mọi khó khăn là cơ hội để bạn trở thành phiên bản mạnh mẽ hơn." FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================================= -->
                    <!-- TRẠNG THÁI 2: ĐÃ NHẬN DIỆN HỘI VIÊN (IDENTIFIED VIP CARD)     -->
                    <!-- ============================================================= -->
                    <Grid Visibility="{Binding IsMemberIdentified, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <!-- Verification Banner Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Member Profile & VIP Card -->
                            <RowDefinition Height="*" />
                            <!-- Countdown & Auto-Reset Footer -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 1. Header Banner Kết quả Xác thực -->
                        <Border Grid.Row="0" CornerRadius="14" Padding="18,12" Margin="0,0,0,20" Background="{Binding StatusBadgeBg}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡ " FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusBadgeText}" FontSize="15" FontWeight="900" Foreground="{Binding StatusBadgeFg}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Large VIP Member Card -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Avatar Frame Lớn với Hiệu Ứng Vòng Sáng Kép -->
                                <Border Width="140" Height="140" CornerRadius="70" Background="#0F172A" BorderBrush="{StaticResource BrushPrimaryOrange}" BorderThickness="3" HorizontalAlignment="Center" Margin="0,4,0,16" Effect="{StaticResource OrangeGlowEffect}">
                                    <Grid>
                                        <!-- Placeholder Vector Icon nếu chưa có ảnh -->
                                        <Path Fill="#334155" Stretch="Uniform" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M12,4 A4,4 0 0,1 16,8 A4,4 0 0,1 12,12 A4,4 0 0,1 8,8 A4,4 0 0,1 12,4 M12,14 C16.42,14 20,15.79 20,18 V20 H4 V18 C4,15.79 7.58,14 12,14 Z" />

                                        <!-- Ảnh Avatar thật từ đường dẫn hội viên -->
                                        <Image Stretch="UniformToFill" Margin="2">
                                            <Image.Clip>
                                                <EllipseGeometry Center="67,67" RadiusX="67" RadiusY="67" />
                                            </Image.Clip>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding MemberAvatarPath}" />
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Tên Hội Viên To & Nổi Bật -->
                                <TextBlock Text="{Binding MemberName}" FontSize="32" FontWeight="900" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding MemberPhone, StringFormat='Số điện thoại: {0}'}" FontSize="14" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16" />

                                <!-- Card Thông Tin Gói Tập -->
                                <Border Background="#131D33" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="GÓI TẬP ĐĂNG KÝ" FontSize="11" FontWeight="800" Foreground="{StaticResource BrushTextMuted}" />
                                            <Border HorizontalAlignment="Right" CornerRadius="8" Padding="10,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter Property="Background" Value="#7F1D1D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RemainingDaysText}" FontSize="12" FontWeight="800" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>

                                        <!-- Tên gói tập -->
                                        <TextBlock Text="{Binding PackageName}" FontSize="20" FontWeight="900" Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding ExpiryDateText}" FontSize="13" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </Border>

                                <!-- Card Chi Tiết Xác Thực Sinh Trắc Học -->
                                <Border Background="#131D33" BorderBrush="#FF6B00" BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Hàng 1: Phương thức xác thực -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="Phương thức:" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding ActiveMethodName}" FontSize="12" FontWeight="800" Foreground="#FFFFFF" />
                                        </Grid>

                                        <!-- Hàng 2: Độ tin cậy thuật toán -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="Độ chính xác:" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding ConfidenceText}" FontSize="12" FontWeight="800" Foreground="#10B981" />
                                        </Grid>

                                        <!-- Hàng 3: Thời gian điểm danh -->
                                        <Grid Grid.Row="2">
                                            <TextBlock Text="Thời gian vào tập:" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding CheckInTimeText}" FontSize="12" FontWeight="700" Foreground="#FFFFFF" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Lời chúc chào mừng sôi nổi -->
                                <Border Background="#0A0F1D" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                                    <TextBlock Text="CHÚC BẠN BUỔI TẬP BÙNG NỔ NĂNG LƯỢNG &amp; HIỆU QUẢ! 💪🔥"
                                               FontSize="12" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}"
                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. Countdown & Auto-Reset Bar -->
                        <Border Grid.Row="2" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tự động quay về màn hình chờ sau:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding CountdownSeconds, StringFormat='{}{0}s'}" FontSize="12" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" />
                                </Grid>
                                <!-- Thanh đếm ngược tiến trình -->
                                <ProgressBar Height="6" Value="{Binding CountdownProgress}" Maximum="100" Minimum="0"
                                             Foreground="{StaticResource BrushPrimaryOrange}" Background="#1E293B" BorderThickness="0">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3" />
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: BOTTOM FOOTER STATUS MARQUEE                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● PHÚC GYM ACCESS SYSTEM" FontSize="11" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,0,16,0" />
                    <TextBlock Text="InsightFace ArcFace Biometric Engine • Pluggable Hardware Provider Architecture • HDMI Customer Display Active" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nhấn " FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="2,0">
                        <TextBlock Text="F11" FontSize="10" FontWeight="800" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text=" Toàn màn hình • " FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="2,0">
                        <TextBlock Text="F12" FontSize="10" FontWeight="800" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text=" Đổi màn hình • " FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="2,0">
                        <TextBlock Text="Esc" FontSize="10" FontWeight="800" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text=" Thu nhỏ / Thoát" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
