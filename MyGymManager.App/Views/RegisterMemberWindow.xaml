<Window x:Class="MyGymManager.App.Views.RegisterMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyGymManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Đăng Ký Hội Viên Mới — Phuc Gym"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#F8F9FA"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushPrimaryOrange" Color="#FF6B00" />
        <SolidColorBrush x:Key="BrushPrimaryOrangeHover" Color="#E65F00" />
        <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#9CA3AF" />

        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Color="#000000" Opacity="0.05" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimaryOrange}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrimaryOrangeHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D1D5DB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto" />
            <!-- 2. Form Content -->
            <RowDefinition Height="*" />
            <!-- 3. Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="ĐĂNG KÝ HỘI VIÊN MỚI" FontSize="18" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock Text="Nhập thông tin hội viên nhanh chóng để kích hoạt thẻ tập tại quầy" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <Border Style="{StaticResource DialogCard}">
                <StackPanel>
                    <TextBlock Text="Thông Tin Hội Viên" FontSize="14" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14" />

                    <!-- Họ và Tên -->
                    <TextBlock Text="Họ và Tên (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,12">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Giới tính & Số điện thoại (2 cột) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Giới tính -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Giới tính (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Nam" IsChecked="{Binding IsMale}" Margin="0,0,16,0" FontSize="13" VerticalContentAlignment="Center" Cursor="Hand" />
                                <RadioButton Content="Nữ" IsChecked="{Binding IsFemale}" FontSize="13" VerticalContentAlignment="Center" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Số điện thoại -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số điện thoại (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <!-- Chọn gói tập -->
                    <TextBlock Text="Chọn Gói Tập (*)" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="Name" SelectedIndex="0" Height="38" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <!-- Tóm tắt gói tập đã chọn -->
                    <Border Background="#F9FAFB" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPackage.Name, FallbackValue='Chưa chọn gói tập'}" FontWeight="700" FontSize="13" Foreground="{StaticResource BrushPrimaryOrange}" />
                            <TextBlock Text="{Binding SelectedPackage.DurationDays, StringFormat='Thời hạn tập: {0} ngày'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SelectedPackage.Price, StringFormat='Đơn giá: {0:#,##0} VNĐ'}" FontSize="12" FontWeight="600" Foreground="#10B981" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tùy chọn gán định danh (Thẻ từ / QR) -->
                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🏷️ Tùy chọn gán định danh vật lý (Không bắt buộc):" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã thẻ từ RFID / NFC" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding CardUid, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mã QR thành viên" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding QrKey, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Thông báo lỗi nếu có -->
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="600" Foreground="#EF4444" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryBtn}" Content="Hủy bỏ" Command="{Binding CancelCommand}" Width="90" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryBtn}" Content="💾 Lưu Hội Viên" Command="{Binding SaveMemberCommand}" IsEnabled="{Binding CanSave}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
