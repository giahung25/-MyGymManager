<Window x:Class="MyGymManager.App.Views.MemberHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lịch Sử Điểm Danh Hội Viên — Phuc Gym"
        Height="580" Width="820"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#F8F9FA">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushPrimaryOrange" Color="#FF6B00" />
        <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#4B5563" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#9CA3AF" />

        <Style x:Key="HistoryDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Header Profile Box -->
            <RowDefinition Height="Auto" />
            <!-- 2. DataGrid History -->
            <RowDefinition Height="*" />
            <!-- 3. Footer Action -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Profile Box -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFullName" Text="Nguyễn Văn A" FontSize="18" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" />
                        <Border x:Name="BadgeGender" Background="#EFF6FF" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGender" Text="Nam" FontSize="11" FontWeight="700" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Số điện thoại: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="TxtPhone" Text="0901 234 567" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0" />
                        <TextBlock Text="Gói tập: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="TxtPackage" Text="VIP 12 Tháng" FontSize="12" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,0,16,0" />
                        <TextBlock Text="Hạn thẻ: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="TxtEndDate" Text="28/12/2026" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Total Check-ins Badge -->
                <Border Grid.Column="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ LƯỢT VÀO TẬP" FontSize="10" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtTotalLogs" Text="0 lượt" FontSize="18" FontWeight="900" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. DataGrid History -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="GridHistory" Style="{StaticResource HistoryDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian điểm danh" Binding="{Binding CheckInTimeFormatted}" Width="160" />
                    <DataGridTextColumn Header="Phương thức xác thực" Binding="{Binding MethodName}" Width="*" />
                    <DataGridTextColumn Header="Độ tin cậy Face ID" Binding="{Binding ConfidenceFormatted}" Width="150" />
                    <DataGridTemplateColumn Header="Trạng thái" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#D1FAE5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="✅ Hợp lệ" FontSize="11" FontWeight="700" Foreground="#047857" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. Footer Action -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Đóng" Click="OnCloseClick" HorizontalAlignment="Right" Width="90" Height="36"
                    Background="#F3F4F6" Foreground="#374151" FontWeight="600" FontSize="13" BorderThickness="1" BorderBrush="#D1D5DB" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </Border>
    </Grid>
</Window>
