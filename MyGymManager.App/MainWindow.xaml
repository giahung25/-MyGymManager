<Window x:Class="MyGymManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyGymManager.App.ViewModels"
        mc:Ignorable="d"
        Title="MyGymManager — Hệ thống Điểm danh &amp; Quản lý Phòng Gym Standalone (.NET 10)"
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <!-- Sport Orange & Clean Palette -->
        <Color x:Key="PrimaryOrangeColor">#FF6B00</Color>
        <Color x:Key="PrimaryOrangeHoverColor">#E05D00</Color>
        <Color x:Key="SoftOrangeBgColor">#FFF3E6</Color>
        <Color x:Key="BorderLightColor">#E5E7EB</Color>
        <Color x:Key="TextDarkColor">#111827</Color>
        <Color x:Key="TextMutedColor">#6B7280</Color>

        <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="{StaticResource PrimaryOrangeColor}" />
        <SolidColorBrush x:Key="PrimaryOrangeHoverBrush" Color="{StaticResource PrimaryOrangeHoverColor}" />
        <SolidColorBrush x:Key="SoftOrangeBgBrush" Color="{StaticResource SoftOrangeBgColor}" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
        <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

        <!-- Nút Cam thể thao phong cách Fluent -->
        <Style x:Key="SportOrangeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryOrangeBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryOrangeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C2410C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phụ trắng xám -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Phong cách Card Trắng Bo Góc -->
        <Style x:Key="CleanCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header & Row Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF7ED" />
            <Setter Property="Foreground" Value="#C2410C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFBF7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEDD5" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Content (Left: Camera, Right: Info & Logs) -->
            <RowDefinition Height="*" />
            <!-- Row 2: Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER: Logo, Tên hệ thống, Trạng thái Camera, Nút Đăng ký -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Logo & Brand Name -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Camera Status, Clock, Register Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon huy hiệu màu cam -->
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource SoftOrangeBgBrush}" Margin="0,0,14,0">
                        <TextBlock Text="🏋️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MYGYM" FontSize="20" FontWeight="Black" Foreground="{StaticResource PrimaryOrangeBrush}" />
                            <TextBlock Text="MANAGER" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextDarkBrush}" Margin="4,0,0,0" />
                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0 STANDALONE" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hệ thống Nhận diện Khuôn mặt &amp; Điểm danh Tự động" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Actions & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Camera Live Status Pill -->
                    <Border Background="#F3F4F6" CornerRadius="20" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding CameraStatusColor}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CameraStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Real-time Clock -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="{Binding SystemClockText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Nút Đăng ký Hội viên mới -->
                    <Button Command="{Binding RegisterNewMemberCommand}" Style="{StaticResource SportOrangeButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Đăng ký Hội viên mới" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- MAIN WORKSPACE: Chia 2 Cột (Trái: Camera, Phải: Thông tin & Logs) -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <!-- Cột Trái: Camera Live (Tỷ lệ 7) -->
                <ColumnDefinition Width="7*" MinWidth="480" />
                <!-- Cột Phải: Member Info Card & DataGrid (Tỷ lệ 5) -->
                <ColumnDefinition Width="5*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- CỘT TRÁI: KHUNG HÌNH LIVE CAMERA           -->
            <!-- ========================================== -->
            <Border Grid.Column="0" Style="{StaticResource CleanCardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Card Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Camera Feed Display -->
                        <RowDefinition Height="*" />
                        <!-- Camera Controls Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Camera Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📹" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Khung Hình Camera Nhận Diện" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource SoftOrangeBgBrush}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="SCRFD + ArcFace 512D" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Camera Viewport (Nền đen bo góc với HUD Overlay) -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <!-- Live Camera Feed Image (Binding CameraFeed) -->
                            <Image x:Name="CameraFeedControl"
                                   Source="{Binding CameraFeed}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                            <!-- Placeholder khi chưa có tín hiệu Camera -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding CameraFeed, Converter={x:Null}}">
                                <TextBlock Text="📷" FontSize="56" HorizontalAlignment="Center" Opacity="0.5" />
                                <TextBlock Text="Đang khởi tạo nguồn Camera USB / RTSP..." FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="Vui lòng kiểm tra kết nối thiết bị" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Khung ngắm khuôn mặt (Face Reticle Overlay Giả lập HUD) -->
                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="260" Height="260" IsHitTestVisible="False">
                                <!-- 4 Góc ngắm màu Cam thể thao -->
                                <!-- Top-Left -->
                                <Path Stroke="{StaticResource PrimaryOrangeBrush}" StrokeThickness="3" Data="M 0,40 L 0,0 L 40,0" />
                                <!-- Top-Right -->
                                <Path Canvas.Left="220" Stroke="{StaticResource PrimaryOrangeBrush}" StrokeThickness="3" Data="M 0,0 L 40,0 L 40,40" />
                                <!-- Bottom-Left -->
                                <Path Canvas.Top="220" Stroke="{StaticResource PrimaryOrangeBrush}" StrokeThickness="3" Data="M 0,0 L 0,40 L 40,40" />
                                <!-- Bottom-Right -->
                                <Path Canvas.Left="220" Canvas.Top="220" Stroke="{StaticResource PrimaryOrangeBrush}" StrokeThickness="3" Data="M 40,0 L 40,40 L 0,40" />

                                <!-- Label HUD giữa khung -->
                                <Border Canvas.Top="230" Canvas.Left="45" Background="#80000000" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="CĂN CHỈNH KHUÔN MẶT VÀO ĐÂY" FontSize="9" FontWeight="Bold" Foreground="#FDBA74" />
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Camera Card Footer Controls -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Nguồn: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="DirectShow (Webcam 0)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <TextBlock Text="Độ trễ: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="&lt; 16ms (Drop-Frame Active)" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding ToggleCameraCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏯️" Margin="0,0,6,0" />
                                    <TextBlock Text="Bật / Tạm dừng Camera" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- CỘT PHẢI: CARD HỘI VIÊN VỪA QUÉT & BẢNG DATAGRID LOGS     -->
            <!-- ======================================================== -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Card Hội viên vừa quét (Height Auto) -->
                    <RowDefinition Height="Auto" />
                    <!-- Bảng Nhật ký Hôm nay (Height *) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- CARD 1: THÔNG TIN HỘI VIÊN VỪA QUÉT MẶT -->
                <Border Grid.Row="0" Style="{StaticResource CleanCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Details: Avatar + Profile -->
                            <RowDefinition Height="Auto" />
                            <!-- Status Badge Box -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Hội Viên Vừa Quét Mặt" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Kết quả AI Realtime" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Member Profile Overview -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <!-- Avatar Frame -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Details -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Profile Circle -->
                            <Border Grid.Column="0" Width="82" Height="82" CornerRadius="41"
                                    BorderBrush="{StaticResource PrimaryOrangeBrush}" BorderThickness="3"
                                    Background="{StaticResource SoftOrangeBgBrush}" Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryOrangeBrush}" />
                            </Border>

                            <!-- Fields -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Họ và Tên -->
                                <TextBlock Text="{Binding MemberFullName}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDarkBrush}" TextTrimming="CharacterEllipsis" />

                                <!-- Số điện thoại -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="📞 " FontSize="12" />
                                    <TextBlock Text="{Binding MemberPhoneNumber}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Gói tập -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="🏷️ " FontSize="12" />
                                    <TextBlock Text="{Binding MemberPackageName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" />
                                </StackPanel>

                                <!-- Hạn thẻ -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="📅 " FontSize="12" />
                                    <TextBlock Text="{Binding MemberExpiryText}" FontSize="12" Foreground="{StaticResource TextDarkBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Status Badge (Màu xanh / Màu đỏ nổi bật) -->
                        <Border Grid.Row="2" Background="{Binding MemberStatusBadgeBg}" CornerRadius="8" Padding="14,10">
                            <TextBlock Text="{Binding MemberStatusBadgeText}"
                                       Foreground="{Binding MemberStatusBadgeFg}"
                                       FontSize="14" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- CARD 2: BẢNG NHẬT KÝ ĐIỂM DANH HÔM NAY (DATAGRID) -->
                <Border Grid.Row="1" Style="{StaticResource CleanCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header & Counter -->
                            <RowDefinition Height="Auto" />
                            <!-- DataGrid -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nhật Ký Điểm Danh Hôm Nay" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Background="{StaticResource SoftOrangeBgBrush}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TodayLogsCountText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" />
                            </Border>
                        </Grid>

                        <!-- DataGrid TodayLogs -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TodayLogs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource BorderLightBrush}"
                                  Background="#FFFFFF"
                                  RowHeaderWidth="0">

                            <DataGrid.Columns>
                                <!-- Giờ vào -->
                                <DataGridTextColumn Header="Giờ vào" Binding="{Binding CheckInTime}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryOrangeBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tên hội viên -->
                                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Gói tập -->
                                <DataGridTextColumn Header="Gói tập" Binding="{Binding PackageName}" Width="*" />

                                <!-- Độ tin cậy (Confidence) -->
                                <DataGridTextColumn Header="Độ khớp" Binding="{Binding Confidence}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Trạng thái -->
                                <DataGridTemplateColumn Header="Trạng thái" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D1FAE5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#065F46" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                    <Setter Property="Foreground" Value="#991B1B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- BOTTOM STATUS BAR                                         -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextDarkBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Động cơ AI: InsightFace SCRFD-10G &amp; ArcFace-R50 • SQLite Local" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
