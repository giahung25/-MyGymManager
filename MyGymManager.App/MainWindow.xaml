<Window x:Class="MyGymManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyGymManager.App"
        xmlns:vm="clr-namespace:MyGymManager.App.ViewModels"
        mc:Ignorable="d"
        Title="Phuc Gym — Smart Attendance &amp; Access Management System"
        Height="880" Width="1440"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, Arial"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Palette Colors -->
        <Color x:Key="ColorPrimaryOrange">#FF6B00</Color>
        <Color x:Key="ColorPrimaryOrangeHover">#E65F00</Color>
        <Color x:Key="ColorBgPrimary">#F8F9FA</Color>
        <Color x:Key="ColorCardBg">#FFFFFF</Color>
        <Color x:Key="ColorBorder">#E5E7EB</Color>
        <Color x:Key="ColorTextPrimary">#111827</Color>
        <Color x:Key="ColorTextSecondary">#4B5563</Color>
        <Color x:Key="ColorTextMuted">#9CA3AF</Color>

        <SolidColorBrush x:Key="BrushPrimaryOrange" Color="{StaticResource ColorPrimaryOrange}" />
        <SolidColorBrush x:Key="BrushPrimaryOrangeHover" Color="{StaticResource ColorPrimaryOrangeHover}" />
        <SolidColorBrush x:Key="BrushPrimaryOrangeLight" Color="#FFF7ED" />
        <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}" />
        <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card Style with 12px CornerRadius -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.04" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimaryOrange}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrimaryOrangeHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="SidebarNavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SidebarNav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" FontSize="14" FontWeight="500" VerticalAlignment="Center" x:Name="navText" Foreground="{StaticResource BrushTextSecondary}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="navText" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrushPrimaryOrangeLight}" />
                                <Setter TargetName="navText" Property="Foreground" Value="{StaticResource BrushPrimaryOrange}" />
                                <Setter TargetName="navText" Property="FontWeight" Value="700" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushPrimaryOrangeLight}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushPrimaryOrange}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Sidebar Width = 260px -->
            <ColumnDefinition Width="260" />
            <!-- 2. Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- SIDEBAR NAVIGATION (260px)                 -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Section -->
                    <RowDefinition Height="90" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- Sidebar Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Section: Phuc Gym -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dumbbell Logo Badge -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrushPrimaryOrange}" Margin="0,0,12,0">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Dumbbell Vector Icon -->
                                <Path Fill="#FFFFFF" Data="M6,5 V11 M18,5 V11 M3,7 V9 M21,7 V9 M6,8 H18" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PHUC GYM" FontSize="19" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" />
                            <TextBlock Text="SMART ATTENDANCE" FontSize="10" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <!-- Item 0: Bảng điều khiển (Mặc định IsChecked=True) -->
                        <RadioButton Style="{StaticResource SidebarNavItem}" Content="Bảng điều khiển" IsChecked="True"
                                     Command="{Binding NavigateTabCommand}" CommandParameter="0">
                            <RadioButton.Tag>
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M3,3 H9 V11 H3 Z M11,3 H17 V7 H11 Z M11,9 H17 V17 H11 Z M3,13 H9 V17 H3 Z" Width="16" Height="16" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- Item 1: Cổng điểm danh -->
                        <RadioButton Style="{StaticResource SidebarNavItem}" Content="Cổng điểm danh"
                                     Command="{Binding NavigateTabCommand}" CommandParameter="1">
                            <RadioButton.Tag>
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M4,4 H7 L8.5,2 H15.5 L17,4 H20 A2,2 0 0,1 22,6 V18 A2,2 0 0,1 20,20 H4 A2,2 0 0,1 2,18 V6 A2,2 0 0,1 4,4 Z M12,7 A5,5 0 1,0 12,17 A5,5 0 1,0 12,7 Z" Width="16" Height="16" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- Item 2: Lịch sử điểm danh -->
                        <RadioButton Style="{StaticResource SidebarNavItem}" Content="Lịch sử điểm danh"
                                     Command="{Binding NavigateTabCommand}" CommandParameter="2">
                            <RadioButton.Tag>
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,6 A1,1 0 0,1 13,7 V12 L16.5,14 A1,1 0 0,1 15.5,15.7 L11.5,13.3 A1,1 0 0,1 11,12 V7 A1,1 0 0,1 12,6 Z" Width="16" Height="16" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- Item 3: Quản lý Hội viên -->
                        <RadioButton Style="{StaticResource SidebarNavItem}" Content="Hội viên"
                                     Command="{Binding NavigateTabCommand}" CommandParameter="3">
                            <RadioButton.Tag>
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 0,0 12,12 Z M4,20 C4,16.7 7.6,14 12,14 C16.4,14 20,16.7 20,20 Z" Width="16" Height="16" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <!-- Item 4: Gói tập Gym -->
                        <RadioButton Style="{StaticResource SidebarNavItem}" Content="Gói tập Gym"
                                     Command="{Binding NavigateTabCommand}" CommandParameter="4">
                            <RadioButton.Tag>
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M3,7 L12,2 L21,7 L12,12 Z M3,9 L12,14 L21,9 V15 L12,20 L3,15 Z" Width="16" Height="16" Stretch="Uniform" />
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hệ thống Offline-First" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <TextBlock Text="Hardware Gateway • SQLite EF Core" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="v1.0.0 Standalone Desktop" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA (Header + Tab Views)     -->
        <!-- ========================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- 1. Header (Height = 72px) -->
                <RowDefinition Height="72" />
                <!-- 2. Dynamic Tab Views -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Title & Breadcrumb -->
                        <ColumnDefinition Width="*" />
                        <!-- Status Pills & Clock -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!-- Right: Camera Status Badge + Live Clock + Customer Facing HDMI Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">


                        <!-- Live Real-Time Clock -->
                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="{StaticResource BrushPrimaryOrange}" Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,6 V12 L16,14" Stroke="{StaticResource BrushPrimaryOrange}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SystemClockText}" FontSize="12" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= DYNAMIC TAB VIEWS ================= -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="0">
                <TabControl.ItemContainerStyle>
                    <!-- Ẩn hoàn toàn header mặc định của TabControl -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ======================================================== -->
                <!-- TAB 0: BẢNG ĐIỀU KHIỂN (DASHBOARD)                        -->
                <!-- ======================================================== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
                        <StackPanel>
                            <!-- Header Dashboard & Nút Xuất Excel -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TỔNG QUAN HOẠT ĐỘNG PHÒNG GYM" FontSize="18" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Báo cáo lưu lượng giờ cao điểm, sức khỏe thẻ tập và xu hướng hội viên" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ExportMembersExcelCommand}" Height="38" Padding="16,0" ToolTip="Xuất toàn bộ danh sách hội viên và trạng thái thẻ ra file Excel (.csv)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥 Xuất Báo Cáo Excel" FontSize="12" FontWeight="700" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 3 Thẻ KPI thống kê nhanh -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Lượt điểm danh hôm nay -->
                                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="ĐIỂM DANH HÔM NAY" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding TodayLogsCountText}" FontSize="32" FontWeight="800" Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,8,0,0" />
                                        <TextBlock Text="Tổng lượt vào phòng tập hôm nay" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Tổng hội viên -->
                                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="6,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TỔNG SỐ HỘI VIÊN" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding MembersList.Count, StringFormat='{}{0} người'}" FontSize="32" FontWeight="800" Foreground="#2563EB" Margin="0,8,0,0" />
                                        <TextBlock Text="Hồ sơ hội viên đã đăng ký" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Gói tập đang mở bán -->
                                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GÓI TẬP HIỆN HÀNH" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding PackagesList.Count, StringFormat='{}{0} gói'}" FontSize="32" FontWeight="800" Foreground="#10B981" Margin="0,8,0,0" />
                                        <TextBlock Text="Gói 1 tháng, 3 tháng, 1 năm" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ================= CỤM BIỂU ĐỒ THỐNG KÊ (CHARTS GRID) ================= -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <!-- Cột Trái: Biểu đồ Giờ cao điểm (Width 60%) -->
                                    <ColumnDefinition Width="6*" />
                                    <!-- Cột Phải: Sức khỏe Thẻ tập & Gói tập (Width 4*) -->
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>

                                <!-- BIỂU ĐỒ 1: LƯỢNG KHÁCH THEO KHUNG GIỜ CAO ĐIỂM -->
                                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0" Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Lưu Lượng Giờ Cao Điểm Hôm Nay" FontSize="15" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="Thống kê số lượng lượt khách tập theo từng khung giờ trong ngày" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="🔥 Peak Hours" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" />
                                            </Border>
                                        </Grid>

                                        <!-- Khung Biểu Đồ Cột Vector XAML -->
                                        <Border Height="180" Background="#F9FAFB" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10,14,8">
                                            <ItemsControl ItemsSource="{Binding HourlyTraffic}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <Grid.RowDefinitions>
                                                                <!-- Số lượng -->
                                                                <RowDefinition Height="Auto" />
                                                                <!-- Cột thanh dọc -->
                                                                <RowDefinition Height="120" />
                                                                <!-- Nhãn giờ -->
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Số lượt trên đỉnh cột -->
                                                            <TextBlock Grid.Row="0" Text="{Binding CountText}" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" HorizontalAlignment="Center" Margin="0,0,0,4" />

                                                            <!-- Cột bar với gradient cam -->
                                                            <Border Grid.Row="1" Width="36" Height="{Binding BarHeight}" CornerRadius="6,6,2,2" VerticalAlignment="Bottom">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF8533" Offset="0.0" />
                                                                        <GradientStop Color="#FF6B00" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- Nhãn khung giờ -->
                                                            <TextBlock Grid.Row="2" Text="{Binding TimeSlot}" FontSize="10" FontWeight="600" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- BIỂU ĐỒ 2: CƠ CẤU HỘI VIÊN & GÓI TẬP -->
                                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Sức Khỏe Thẻ Tập &amp; Gói Tập" FontSize="15" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                        <!-- Phân bổ trạng thái thẻ -->
                                        <TextBlock Text="TỶ LỆ TRẠNG THÁI HỘI VIÊN" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
                                        
                                        <!-- 3 Card mini chỉ số trạng thái -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Đang hoạt động -->
                                            <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="🟢 Đang tập" FontSize="10" FontWeight="600" Foreground="#047857" />
                                                    <TextBlock Text="{Binding ActiveMembersCount, StringFormat='{}{0} người'}" FontSize="14" FontWeight="800" Foreground="#065F46" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Sắp hết hạn -->
                                            <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="⏰ Sắp hết" FontSize="10" FontWeight="600" Foreground="#B45309" />
                                                    <TextBlock Text="{Binding ExpiringSoonMembersCount, StringFormat='{}{0} người'}" FontSize="14" FontWeight="800" Foreground="#92400E" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Đã hết hạn -->
                                            <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="❌ Hết hạn" FontSize="10" FontWeight="600" Foreground="#B91C1C" />
                                                    <TextBlock Text="{Binding ExpiredMembersCount, StringFormat='{}{0} người'}" FontSize="14" FontWeight="800" Foreground="#991B1B" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Phân bổ theo Gói Tập -->
                                        <TextBlock Text="PHÂN BỔ THEO GÓI TẬP" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,8" />
                                        <ItemsControl ItemsSource="{Binding PackageBreakdown}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding PackageName}" FontSize="12" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <ProgressBar Grid.Column="1" Value="{Binding Percentage}" Maximum="100" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{Binding ColorHex}" Background="#F3F4F6" BorderThickness="0">
                                                            <ProgressBar.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4" />
                                                                </Style>
                                                            </ProgressBar.Resources>
                                                        </ProgressBar>
                                                        <TextBlock Grid.Column="2" Text="{Binding PercentageText}" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bảng xem trước lịch sử điểm danh gần đây -->
                            <Border Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="Lượt điểm danh gần nhất" FontSize="16" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />
                                    <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TodayLogs}" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Thời gian" Binding="{Binding CheckInTime}" Width="120" />
                                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*" />
                                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="140" />
                                            <DataGridTextColumn Header="Gói tập" Binding="{Binding PackageName}" Width="160" />
                                            <DataGridTextColumn Header="Độ tin cậy" Binding="{Binding Confidence}" Width="120" />
                                            <DataGridTemplateColumn Header="Trạng thái" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                            <Setter Property="Background" Value="#FFEDD5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="600">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                                <Setter Property="Foreground" Value="#EA580C" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================================================== -->
                <!-- TAB 1: CỔNG ĐIỂM DANH (HARDWARE ACCESS TERMINAL)           -->
                <!-- ======================================================== -->
                <TabItem>
                    <Grid Margin="28">
                        <Grid.ColumnDefinitions>
                            <!-- Cột Trái (Camera + Thao tác): Width 500px -->
                            <ColumnDefinition Width="500" />
                            <!-- Cột Phải (Kết quả quẹt mặt + Bảng nhật ký): Width * -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ================= CỘT TRÁI ================= -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
                            <StackPanel>
                                <!-- CARD 1: KHUNG CAMERA LIVE & GUIDE OVAL -->
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="Camera Giám Sát (Tùy chọn)" FontSize="16" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            <Border Background="#F3F4F6" CornerRadius="12" Padding="8,4" HorizontalAlignment="Right">
                                                <TextBlock Text="CCTV" FontSize="11" FontWeight="700" Foreground="{StaticResource BrushTextMuted}" />
                                            </Border>
                                        </Grid>

                                        <!-- Hàng chọn nguồn Camera & Nút quét lại thiết bị -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableCameras}"
                                                      SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Height="36"
                                                      FontSize="12"
                                                      VerticalContentAlignment="Center"
                                                      ToolTip="Chọn thiết bị camera muốn sử dụng để quét khuôn mặt" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding RefreshCamerasCommand}"
                                                    Height="36"
                                                    Padding="12,0"
                                                    ToolTip="Quét lại toàn bộ camera đang cắm vào máy tính">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔄 Quét lại" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Camera Feed Container với Khung Oval Overlay -->
                                        <Border Height="360" Background="#111827" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,14">
                                            <Grid>
                                                <!-- Video Stream từ OpenCvSharp -->
                                                <Image Source="{Binding CameraFeed}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Nút Bật/Tắt Camera -->
                                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCameraCommand}" Height="42" Margin="0,0,0,8">
                                                <TextBlock Text="Bật / Tắt Camera Giám Sát" />
                                        </Button>

                                        <!-- Thông báo trạng thái camera -->
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: ĐIỂM DANH THỦ CÔNG QUA SỐ ĐIỆN THOẠI -->
                                <Border Style="{StaticResource ModernCard}">
                                    <StackPanel>
                                        <TextBlock Text="Điểm Danh Thủ Công" FontSize="15" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                        <TextBlock Text="Nhập số điện thoại hội viên khi camera chưa quét được:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding ManualPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="40" Padding="12,0" VerticalContentAlignment="Center" FontSize="14"
                                                     BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8" />
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ManualCheckInCommand}" Height="40" Padding="16,0" Content="Xác nhận" />
                                        </Grid>

                                        <TextBlock Text="{Binding ManualCheckInStatus}" FontSize="12" FontWeight="600" Foreground="{Binding StatusColor}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= CỘT PHẢI ================= -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <!-- 1. Card Kết Quả Quét Mặt -->
                                <RowDefinition Height="Auto" />
                                <!-- 2. Bảng Quét Thẻ Gần Nhất Trong Ngày -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- CARD 3: THẺ CHÀO MỪNG LỚN (HERO WELCOME CARD) & TRẠNG THÁI PHẦN CỨNG -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <Border Style="{StaticResource ModernCard}" Padding="22,18" Margin="0,0,0,12">
                                    <Grid MinHeight="130">
                                        <!-- TRẠNG THÁI 1: CHỜ XÁC THỰC (IDLE STATE khi HasCurrentMember = False) -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCurrentMember}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon thiết bị / Đầu đọc thẻ -->
                                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="16" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Fill="{StaticResource BrushPrimaryOrange}"
                                                      Data="M4,4 H20 A2,2 0 0,1 22,6 V18 A2,2 0 0,1 20,20 H4 A2,2 0 0,1 2,18 V6 A2,2 0 0,1 4,4 Z M4,8 H20 V6 H4 Z M6,14 H10 V16 H6 Z M12,14 H18 V16 H12 Z"
                                                      Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Nội dung hướng dẫn trạng thái Chờ -->
                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="CỔNG SẴN SÀNG" FontSize="11" FontWeight="700" Foreground="#047857" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="HỆ THỐNG SẴN SÀNG" FontSize="20" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6" />
                                                <TextBlock Text="Vui lòng quẹt thẻ từ RFID, quét mã QR hoặc nhập số điện thoại tại quầy" FontSize="13" FontWeight="500" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- TRẠNG THÁI 2: ĐÃ NHẬN DIỆN (IDENTIFIED STATE khi HasCurrentMember = True) -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCurrentMember}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar hoặc Icon Hội viên -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="90" Height="90" CornerRadius="45" Background="#F3F4F6" BorderBrush="{Binding StatusColor}" BorderThickness="3" ClipToBounds="True">
                                                    <Grid>
                                                        <Path Fill="{StaticResource BrushTextMuted}" Data="M12,12 A5,5 0 1,0 12,2 A5,5 0 0,0 12,12 Z M4,22 C4,18 7.5,15 12,15 C16.5,15 20,18 20,22 Z" Width="46" Height="46" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Thông tin Hội viên & Badge Trạng thái & Badge Thiết bị -->
                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                                <!-- Hàng Badge: Trạng thái & Phương thức xác thực -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Background="{Binding MemberStatusBadgeBg}" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding MemberStatusBadgeText}" FontSize="12" FontWeight="700" Foreground="{Binding MemberStatusBadgeFg}" />
                                                    </Border>
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                                        <TextBlock Text="{Binding AuthDeviceBadgeText}" FontSize="12" FontWeight="700" Foreground="#1D4ED8" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Tên Hội viên (to, đậm) -->
                                                <TextBlock Text="{Binding MemberFullName}" FontSize="24" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />

                                                <!-- Gói tập & Hạn thẻ -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Gói tập:" FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MemberPackageName}" FontSize="13" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" />

                                                    <TextBlock Grid.Column="2" Text="Số điện thoại:" FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="12,0,6,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding MemberPhoneNumber}" FontSize="13" FontWeight="600" Foreground="{StaticResource BrushTextPrimary}" />
                                                </Grid>

                                                <!-- Hạn thẻ / Số ngày còn lại -->
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Thời hạn thẻ: " FontSize="13" Foreground="{StaticResource BrushTextMuted}" />
                                                    <TextBlock Text="{Binding MemberExpiryText}" FontSize="13" FontWeight="600" Foreground="{StaticResource BrushTextSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- THANH TRẠNG THÁI KẾT NỐI PHẦN CỨNG NGOẠI VI -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- RFID Reader Status -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Đầu đọc thẻ RFID: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="Sẵn sàng" FontSize="12" FontWeight="700" Foreground="#10B981" />
                                        </StackPanel>

                                        <!-- QR Scanner Status -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Máy quét QR: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="Sẵn sàng" FontSize="12" FontWeight="700" Foreground="#10B981" />
                                        </StackPanel>

                                        <!-- LAN Attendance Status -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Máy chấm công LAN: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="Đang kết nối" FontSize="12" FontWeight="700" Foreground="#0284C7" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- CARD 4: BẢNG LỊCH SỬ ĐIỂM DANH TRONG NGÀY -->
                            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="20,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Bảng Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Lịch Sử Điểm Danh Hôm Nay" FontSize="16" FontWeight="700" Foreground="{StaticResource BrushTextPrimary}" />
                                            <Border Background="{StaticResource BrushPrimaryOrangeLight}" CornerRadius="12" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding TodayLogsCountText}" FontSize="12" FontWeight="700" Foreground="{StaticResource BrushPrimaryOrange}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Làm mới" Height="32" Padding="12,0" HorizontalAlignment="Right" Command="{Binding RefreshLogsCommand}" />
                                    </Grid>

                                    <!-- Bảng DataGrid hiển thị realtime -->
                                    <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TodayLogs}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Giờ vào" Binding="{Binding CheckInTime}" Width="110" />
                                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*" />
                                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="130" />
                                            <DataGridTextColumn Header="Gói tập" Binding="{Binding PackageName}" Width="160" />
                                            <DataGridTextColumn Header="Độ tin cậy" Binding="{Binding Confidence}" Width="110" />
                                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                            <Setter Property="Background" Value="#FFEDD5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="600">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#047857" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                                <Setter Property="Foreground" Value="#EA580C" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ======================================================== -->
                <!-- TAB 2: LỊCH SỬ ĐIỂM DANH TOÀN DIỆN (CHECKIN LOGS)         -->
                <!-- ======================================================== -->
                <TabItem>
                    <Grid Margin="28">
                        <Border Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Nhật Ký Điểm Danh Hệ Thống" FontSize="18" FontWeight="800" Foreground="{StaticResource BrushTextPrimary}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Làm mới" Height="34" Padding="14,0" HorizontalAlignment="Right" Command="{Binding RefreshLogsCommand}" />
                                </Grid>

                                <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TodayLogs}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding CheckInTime}" Width="120" />
                                        <DataGridTextColumn Header="Họ và Tên Hội Viên" Binding="{Binding FullName}" Width="*" />
                                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="150" />
                                        <DataGridTextColumn Header="Gói tập hiện tại" Binding="{Binding PackageName}" Width="180" />
                                        <DataGridTextColumn Header="Độ tin cậy" Binding="{Binding Confidence}" Width="130" />
                                        <DataGridTemplateColumn Header="Trạng thái" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D1FAE5" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="600">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#047857" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                            <Setter Property="Foreground" Value="#EA580C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================================================== -->
                <!-- TAB 3: QUẢN LÝ HỘI VIÊN (MEMBERS MANAGEMENT)              -->
                <!-- ======================================================== -->
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <!-- Search & Action Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- DataGrid -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Thanh tìm kiếm & Nút thêm mới -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Input Box -->
                            <TextBox Grid.Column="0" Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="42" Padding="14,0" VerticalContentAlignment="Center" FontSize="14"
                                     BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- 4 Nút Lọc Trạng Thái Hội Viên -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <!-- 1. Tất cả -->
                                <Button Command="{Binding SetMemberFilterCommand}" CommandParameter="All"
                                        Height="38" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Setter Property="FontWeight" Value="600" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterAllActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushPrimaryOrange}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaryOrange}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Tất cả" FontSize="12" />
                                </Button>

                                <!-- 2. Đang tập -->
                                <Button Command="{Binding SetMemberFilterCommand}" CommandParameter="Active"
                                        Height="38" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Setter Property="FontWeight" Value="600" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterActiveActive}" Value="True">
                                                    <Setter Property="Background" Value="#10B981" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#059669" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="🟢 Đang tập" FontSize="12" />
                                </Button>

                                <!-- 3. Sắp hết hạn (7 ngày) -->
                                <Button Command="{Binding SetMemberFilterCommand}" CommandParameter="ExpiringSoon"
                                        Height="38" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Setter Property="FontWeight" Value="600" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterExpiringSoonActive}" Value="True">
                                                    <Setter Property="Background" Value="#F59E0B" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="⏰ Sắp hết hạn (7 ngày)" FontSize="12" />
                                </Button>

                                <!-- 4. Đã hết hạn -->
                                <Button Command="{Binding SetMemberFilterCommand}" CommandParameter="Expired"
                                        Height="38" Padding="14,0" Cursor="Hand" BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F3F4F6" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Setter Property="FontWeight" Value="600" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterExpiredActive}" Value="True">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="❌ Đã hết hạn" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <!-- Actions: Xuất Excel, Thêm mới hội viên & Làm mới -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportMembersExcelCommand}" Height="42" Margin="0,0,10,0" ToolTip="Xuất danh sách hội viên và trạng thái thẻ ra file Excel (.csv)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥 Xuất Excel" FontSize="12" FontWeight="600" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Content="Làm mới" Command="{Binding RefreshMembersCommand}" Height="42" Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="+ Đăng ký Hội viên mới" Command="{Binding RegisterNewMemberCommand}" Height="42" />
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid Danh sách hội viên -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" ClipToBounds="True">
                            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding MembersList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*" />
                                    <DataGridTextColumn Header="Giới tính" Binding="{Binding Gender}" Width="90" />
                                    <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="140" />
                                    <DataGridTextColumn Header="Gói tập" Binding="{Binding Package.Name}" Width="170" />
                                    <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
                                    <DataGridTextColumn Header="Ngày hết hạn" Binding="{Binding EndDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
                                    <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#D1FAE5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="600">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Hoạt động" />
                                                                <Setter Property="Foreground" Value="#047857" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="Bị khóa" />
                                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mã Thẻ / QR Code" Binding="{Binding HardwareIdentifier}" Width="140" />
                                    <DataGridTemplateColumn Header="Thao tác" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Xem lịch sử"
                                                            Command="{Binding DataContext.ViewMemberHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Height="28" Padding="8,0" Margin="0,0,6,0" FontSize="11"
                                                            ToolTip="Xem các lượt điểm danh của riêng hội viên này" />
                                                    <Button Content="Sửa"
                                                            Command="{Binding DataContext.EditMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11" />
                                                    <Button Content="Xóa"
                                                            Command="{Binding DataContext.DeleteMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FECACA" BorderThickness="1"
                                                            FontWeight="600" Height="28" Padding="10,0" FontSize="11" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================================================== -->
                <!-- TAB 4: QUẢN LÝ GÓI TẬP (PACKAGES MANAGEMENT)              -->
                <!-- ======================================================== -->
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <!-- Search & Action Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- DataGrid -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Thanh tìm kiếm gói tập -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding PackageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="42" Padding="14,0" VerticalContentAlignment="Center" FontSize="14"
                                     BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Làm mới" Command="{Binding RefreshPackagesCommand}" Height="42" Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="+ Tạo gói tập mới" Command="{Binding AddPackageCommand}" Height="42" />
                            </StackPanel>
                        </Grid>

                        <!-- Bảng danh sách gói tập -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" ClipToBounds="True">
                            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding PackagesList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên gói tập" Binding="{Binding Name}" Width="240" />
                                    <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationDays, StringFormat='{}{0} ngày'}" Width="130" />
                                    <DataGridTextColumn Header="Đơn giá (VNĐ)" Binding="{Binding Price, StringFormat='{}{0:#,##0} VNĐ'}" Width="180" />
                                    <DataGridTextColumn Header="Mô tả chi tiết" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Số hội viên" Binding="{Binding Members.Count, StringFormat='{}{0} người'}" Width="120" />
                                    <DataGridTemplateColumn Header="Thao tác" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Sửa"
                                                            Command="{Binding DataContext.EditPackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11" />
                                                    <Button Content="Xóa"
                                                            Command="{Binding DataContext.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FECACA" BorderThickness="1"
                                                            FontWeight="600" Height="28" Padding="10,0" FontSize="11" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
